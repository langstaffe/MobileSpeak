          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar con el servidor de TeamSpeak de la red local que elijas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
