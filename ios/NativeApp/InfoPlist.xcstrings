        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線到你選擇的區域網路 TeamSpeak 伺服器。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение к выбранному вами серверу TeamSpeak в локальной сети."
