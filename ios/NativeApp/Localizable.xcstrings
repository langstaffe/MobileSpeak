    "files_cache_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Downloads und vorbereitete Uploads für alle Server und Kanäle in MobileSpeak entfernen. Serverdateien, Originaldateien und exportierte Kopien bleiben erhalten. Für fehlgeschlagene Uploads muss die Datei neu ausgewählt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove local downloads and upload staging for all servers and channels in MobileSpeak. Server files, original files, and exported copies are unaffected. Failed uploads will need a new file selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán las descargas locales y los archivos preparados para subir de todos los servidores y canales de MobileSpeak. Los archivos del servidor, los originales y las copias exportadas no se verán afectados. Tendrás que volver a seleccionar el archivo para las subidas fallidas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán las descargas locales y los archivos preparados para subir de todos los servidores y canales de MobileSpeak. Los archivos del servidor, los originales y las copias exportadas no se verán afectados. Tendrás que volver a seleccionar el archivo para las subidas fallidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer les téléchargements locaux et les fichiers préparés pour l’envoi de tous les serveurs et salons dans MobileSpeak. Les fichiers du serveur, les originaux et les copies exportées sont conservés. Il faudra sélectionner à nouveau les fichiers dont l’envoi a échoué."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń lokalnie pobrane pliki i pliki przygotowane do przesłania dla wszystkich serwerów i kanałów w MobileSpeak. Pliki na serwerach, oryginały i wyeksportowane kopie pozostaną bez zmian. Nieudane przesłania będą wymagały ponownego wyboru pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover downloads locais e arquivos preparados para envio de todos os servidores e canais no MobileSpeak. Os arquivos do servidor, os originais e as cópias exportadas não serão afetados. Para envios que falharam, será necessário selecionar o arquivo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить локально скачанные и подготовленные к загрузке файлы всех серверов и каналов MobileSpeak. Файлы на сервере, оригиналы и экспортированные копии сохранятся. Для неудавшихся загрузок понадобится заново выбрать файл."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除 MobileSpeak 内所有服务器、频道的本地下载和上传暂存。服务器文件、原始文件及已导出的文件不受影响。失败的上传需重新选择文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 MobileSpeak 中所有伺服器和頻道的本機下載檔案與上傳暫存檔。伺服器檔案、原始檔案及已匯出的副本不受影響。上傳失敗的檔案需要重新選擇。"
          }
        }
      }
    },
