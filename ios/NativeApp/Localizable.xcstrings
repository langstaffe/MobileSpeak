        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Keine“ deaktiviert die Rauschunterdrückung von MobileSpeak. Die Sprachverarbeitung des Systems kann weiterhin aktiv sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None disables MobileSpeak noise suppression. System voice processing may still apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ninguna» desactiva la supresión de ruido de MobileSpeak. El sistema puede seguir procesando la voz."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
