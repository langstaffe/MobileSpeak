    "avatar_clear_confirm_connected" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokalen Avatar und deinen persönlichen Avatar auf diesem Server entfernen. Avatare auf anderen Servern werden bei der nächsten Verbindung entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear the local avatar and your personal avatar on this server. Avatars on other servers will be cleared the next time you connect to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán el avatar local y tu avatar personal de este servidor. Los avatares de los demás servidores se borrarán la próxima vez que te conectes a ellos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán el avatar local y tu avatar personal de este servidor. Los avatares de los demás servidores se borrarán la próxima vez que te conectes a ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer l’avatar local et votre avatar personnel sur ce serveur. Les avatars des autres serveurs seront effacés à la prochaine connexion."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć lokalny awatar i Twój awatar na tym serwerze? Awatary na innych serwerach zostaną usunięte przy następnym połączeniu z nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover o avatar local e seu avatar pessoal neste servidor. Os avatares nos outros servidores serão removidos na próxima conexão com eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить локальный аватар и ваш аватар на этом сервере. На других серверах аватар будет удалён при следующем подключении к ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除本地头像，并清除当前服务器上的个人头像。其他服务器上的头像将在下次连接时清除。"
