    "avatar_help" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine globale Avatareinstellung wird beim Verbinden mit dem jeweiligen Server synchronisiert. Das Entfernen gilt für andere Server bei der nächsten Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your global avatar setting syncs with each server when you connect. Clearing applies to other servers on their next connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu avatar global se sincroniza con cada servidor al conectarte. El borrado se aplicará a los demás servidores la próxima vez que te conectes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu avatar global se sincroniza con cada servidor al conectarte. El borrado se aplicará a los demás servidores la próxima vez que te conectes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre avatar global est synchronisé avec chaque serveur à la connexion. Sa suppression sera appliquée aux autres serveurs lors de la prochaine connexion."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienie globalnego awatara jest synchronizowane z każdym serwerem przy łączeniu. Usunięcie zostanie zastosowane na innych serwerach przy następnym połączeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu avatar global é sincronizado com cada servidor ao se conectar. A remoção será aplicada aos outros servidores na próxima conexão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий аватар синхронизируется с каждым сервером при подключении. Удаление применится к другим серверам при следующем подключении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全局头像设置会在连接各服务器时逐个同步。清除后，其他服务器上的头像将在下次连接时清除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全域頭像設定會在連線各伺服器時逐個同步。清除後，其他伺服器上的頭像將在下次連線時清除。"
          }
        }
      }
    },
