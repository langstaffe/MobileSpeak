    "settings_dpdfnet_performance" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 benötigt mehr Prozessorleistung und Akku. Auf langsameren Geräten kann der Ton aussetzen, besonders im Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 uses more CPU and battery. Slower devices may have interrupted audio, especially in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 consume más CPU y batería. En dispositivos lentos puede haber cortes de audio, sobre todo en segundo plano."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 consume más CPU y batería. En dispositivos lentos puede haber cortes de audio, sobre todo en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 sollicite davantage le processeur et la batterie. Le son peut être interrompu sur les appareils moins puissants, surtout en arrière-plan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 zużywa więcej procesora i baterii. Na wolniejszych urządzeniach dźwięk może się przerywać, zwłaszcza w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DPDFNet2 usa mais CPU e bateria. Dispositivos mais lentos podem apresentar cortes de áudio, especialmente em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 увеличивает нагрузку на процессор и расход батареи. На медленных устройствах возможны прерывания звука, особенно в фоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 的处理和耗电开销较高；较慢设备尤其在后台可能出现语音断续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DPDFNet2 會消耗較多處理器資源和電量。效能較低的裝置可能出現語音斷續，尤其是在背景執行時。"
          }
        }
      }
    },
